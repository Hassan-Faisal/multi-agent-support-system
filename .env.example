# Copy to .env. Used by docker compose and by the backend when run locally.

# --- Required
ANTHROPIC_API_KEY=            # agents and triage
OPENAI_API_KEY=               # embeddings for the help-center index
SUPPORT_JWT_SECRET=           # any long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"

# --- Models (any provider:model string accepted by langchain's init_chat_model)
SUPPORT_LLM_MODEL=anthropic:claude-sonnet-5-5
SUPPORT_TRIAGE_MODEL=anthropic:claude-haiku-5-5

# --- Run without an OpenAI key: lexical-only embeddings (fine for demos, weaker on paraphrases)
# SUPPORT_EMBEDDING_PROVIDER=hashing

# --- Local development outside Docker
# SUPPORT_DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support
# SUPPORT_LOG_JSON=false
# SUPPORT_KB_DIR=knowledge_base

# --- Optional: LangSmith tracing of every agent run
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=nimbus-support

# --- Policy and guardrails (defaults shown)
# SUPPORT_REFUND_AUTO_APPROVE_LIMIT=50.00
# SUPPORT_REFUND_WINDOW_DAYS=30
# SUPPORT_RETURN_WINDOW_DAYS=30
# SUPPORT_RATE_LIMIT_PER_MINUTE=20
# SUPPORT_MAX_HANDOFFS_PER_TURN=3
# SUPPORT_MAX_TOOL_STEPS_PER_AGENT=8
# SUPPORT_ENABLE_DEMO_ACCOUNTS=true
