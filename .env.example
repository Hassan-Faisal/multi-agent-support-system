# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Any provider:model string accepted by langchain's init_chat_model.
SUPPORT_MODEL=anthropic:claude-sonnet-5-5
# Routing is simple classification; a smaller model keeps it fast and cheap.
SUPPORT_TRIAGE_MODEL=anthropic:claude-haiku-5-5

# To use OpenAI instead: pip install langchain-openai, set OPENAI_API_KEY, and e.g.
# SUPPORT_MODEL=openai:gpt-4.1

# Guardrails and policy (defaults shown)
# SUPPORT_MAX_HANDOFFS=3
# SUPPORT_MAX_TOOL_STEPS=8
# SUPPORT_REFUND_LIMIT=50
# SUPPORT_REFUND_WINDOW_DAYS=30
# SUPPORT_RETURN_WINDOW_DAYS=30
# SUPPORT_DB_PATH=data/support.db
